<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:gravity="center"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Select Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSelectMedia"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/select_media"
        android:contentDescription="@string/accessibility_select"
        app:icon="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Selected file info -->
    <TextView
        android:id="@+id/tvMediaInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:maxLines="2"
        android:ellipsize="middle"
        android:contentDescription="@string/media_info"
        app:layout_constraintTop_toBottomOf="@id/btnSelectMedia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Player View (for video) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@color/black"
        android:contentDescription="@string/accessibility_player"
        app:use_controller="false"
        app:layout_constraintTop_toBottomOf="@id/tvMediaInfo"
        app:layout_constraintBottom_toTopOf="@id/tvCurrentPosition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintHeight_max="280dp" />

    <!-- Current Position -->
    <TextView
        android:id="@+id/tvCurrentPosition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/current_position"
        android:textSize="14sp"
        android:contentDescription="@string/current_position"
        app:layout_constraintTop_toBottomOf="@id/playerView"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Duration -->
    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/duration"
        android:textSize="14sp"
        android:contentDescription="@string/duration"
        app:layout_constraintTop_toTopOf="@id/tvCurrentPosition"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- SeekBar -->
    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:max="1000"
        android:progress="0"
        android:contentDescription="@string/accessibility_seekbar"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentPosition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start / End markers info -->
    <LinearLayout
        android:id="@+id/markerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvStartTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_time"
            android:textColor="@color/marker_start"
            android:textStyle="bold"
            android:contentDescription="@string/start_time" />

        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="@string/end_time"
            android:textColor="@color/marker_end"
            android:textStyle="bold"
            android:contentDescription="@string/end_time" />
    </LinearLayout>

    <!-- Control Buttons Row 1: Play, Rewind, Forward -->
    <LinearLayout
        android:id="@+id/controlsRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/markerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRewind"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/rewind"
            android:contentDescription="@string/accessibility_rewind"
            app:icon="@android:drawable/ic_media_rew" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/play"
            android:contentDescription="@string/accessibility_play_pause"
            app:icon="@android:drawable/ic_media_play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnForward"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/forward"
            android:contentDescription="@string/accessibility_forward"
            app:icon="@android:drawable/ic_media_ff" />
    </LinearLayout>

    <!-- Control Buttons Row 2: Set Start, Set End -->
    <LinearLayout
        android:id="@+id/controlsRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/controlsRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetStart"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/set_start"
            android:contentDescription="@string/accessibility_set_start"
            app:backgroundTint="@color/marker_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetEnd"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/set_end"
            android:contentDescription="@string/accessibility_set_end"
            app:backgroundTint="@color/marker_end" />
    </LinearLayout>

    <!-- Seek Seconds input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSeekSeconds"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/seek_seconds_label"
        app:layout_constraintTop_toBottomOf="@id/controlsRow2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSeekSeconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="5"
            android:maxLength="2"
            android:contentDescription="@string/seek_seconds_hint" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Trim Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnTrim"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/trim"
        android:contentDescription="@string/accessibility_trim"
        app:icon="@android:drawable/ic_menu_crop"
        app:layout_constraintTop_toBottomOf="@id/tilSeekSeconds"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Progress overlay -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:contentDescription="@string/processing"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
